<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:svg="http://www.w3.org/2000/svg"
  xmlns:math="http://www.w3.org/1998/Math/MathML" xmlns="http://www.tei-c.org/ns/1.0">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>ODD test pour la modélisation : schéma spécifique aux éléments des tables stories + witness </title>
        <author>Maud Mélinand</author>
      </titleStmt>
      <publicationStmt>
        <p/>
      </publicationStmt>
      <sourceDesc>
        <p>Document conforme aux guidelines de la TEI-P5</p>
      </sourceDesc>
    </fileDesc>
  </teiHeader>
  <text>
    <body>
      <div>
        <head>Création d'un ODD test à partir des données du projet LostMa</head>
        <p>Ce schéma définit une customisation TEI pour l'encodage des données contenues dans les tables 'parts' et 'witnesses'.</p>
      </div>
      
      <div>
        <schemaSpec ident="test_lostma_text" start="TEI">
          
          <!-- Modules utilisés -->
          
          <moduleRef key="tei"/>
          
          <moduleRef key="core"/>
          
          <moduleRef key="header"/>
          
          <moduleRef key="msdescription"/>
          
          <moduleRef key="textstructure"/>
          
          <moduleRef key="namesdates"/>
          
          <moduleRef key="linking"/>
          
          <moduleRef key="corpus"/>
          
          <moduleRef key="verse"/>
          
          <moduleRef key="spoken"/>
          
          <moduleRef key="dictionaries"/>
          
          <moduleRef key="nets"/>
          
          <moduleRef key="textcrit"/>
         
         <!-- TEI racine --> 
          
         <elementSpec ident="TEI" mode="change">
           <desc>The TEI element takes two children, teiHeader and text. One @xml:id is required.</desc>
           <content>
             <sequence>
               <elementRef key="teiHeader"/>
               <elementRef key="text"/>
             </sequence>
           </content>
           <attList>
             <attDef ident="xml:id" mode="change" usage="req">
               <datatype>
                 <dataRef name="ID"/>
               </datatype>
             </attDef>
           </attList>
           <remarks>
             <p>The xml:id is required in order to comply to DoTS's specifications. Its structure must always be hid_123 (equivalent to the Heurist ID).</p>
           </remarks>
         </elementSpec>
          
          <!-- Elements à rajouter : listWit / witness - listBibl / bibl -->
          
          <!-- Module header -->
          
          <!-- teiHeader -->
          
          <elementSpec ident="teiHeader" mode="change">
            <desc>teiHeader takes only three children : fileDesc, encodingDesc and profileDesc.</desc>
            <content>
              <sequence>
                <elementRef key="fileDesc"/>
                <elementRef key="encodingDesc"/>
                <elementRef key="profileDesc"/>
              </sequence>
            </content>
          </elementSpec>
          
          <!-- fileDesc -->
          
          <elementSpec ident="fileDesc" mode="change">
            <desc>The element fileDesc accepts only titleStmt, publicationStmt (optional) and sourceDesc as child elements.</desc>
            <content>
              <sequence>
                <elementRef key="titleStmt" minOccurs="1" maxOccurs="1"/>
                <elementRef key="publicationStmt" minOccurs="0" maxOccurs="1"/>
                <elementRef key="sourceDesc" minOccurs="1" maxOccurs="1"/>
              </sequence>
            </content>
          </elementSpec>
          
          <!-- titleStmt -->
          
          <elementSpec ident="titleStmt" mode="change">
            <desc>The element titleStmt takes a required children-elements title, principal and respStmt.</desc>
            <content>
              <sequence>
                <elementRef key="title" minOccurs="1" maxOccurs="unbounded"/>
                <elementRef key="author" minOccurs="0" maxOccurs="unbounded"/>
                <elementRef key="principal" minOccurs="1" maxOccurs="1"/>
                <elementRef key="respStmt" minOccurs="1" maxOccurs="unbounded"/>
              </sequence>
            </content>
            <remarks>
              <p>Title is required in order to comply to DoTS's requirements.</p>
            </remarks>
          </elementSpec>
          
          <!-- title -->
          
          <elementSpec ident="title" mode="change">
            <desc>The element title takes an @type preferred and a textnode.</desc>
            <content>
              <textNode/>
            </content>
            <attList>
              <attDef ident="type" mode="change" usage="rec">
                <datatype>
                  <dataRef name="string"/>
                </datatype>
              </attDef>
            </attList>
            <remarks>
               <p>Equivalent to the DB's TextTable_preferred_name.</p>
            </remarks>
          </elementSpec>
          
          <!-- author -->
          
          <elementSpec ident="author" mode="change">
            <content>
              <sequence>
                <textNode/>
                <elementRef key="note" minOccurs="0" maxOccurs="unbounded"/>
              </sequence>
            </content>
            <remarks>
              <p>The element author receives as input the data from the DB's TextTable_is_written_by Name.</p>
              <p>The child-element note receives as input the DB's TextTable_author_freetext. </p>
            </remarks>
          </elementSpec>
          
          
          <!-- principal -->
          
          <elementSpec ident="principal" mode="change">
            <desc>The element is used to contains the name of the researcher primarily responsible for the creation of an electronic text.</desc>
            <content>
              <elementRef key="persName" minOccurs="1" maxOccurs="1"/>
            </content>
            <remarks>
              <p>This element will store Heurist metadata once extracted.</p>
            </remarks>
          </elementSpec>
          
          <!-- persName -->
          
          <elementSpec ident="persName" mode="change">
            <desc>The element is used to input a name. It takes children element forename and surname.</desc>
            <content>
              <sequence>
                <elementRef key="forename" minOccurs="1" maxOccurs="1"/>
                <elementRef key="surname" minOccurs="1" maxOccurs="1"/>
              </sequence>
            </content>
            <remarks>
              <p>This element will store Heurist metadata once extracted.</p>
            </remarks>
          </elementSpec>
          
          <!-- respStmt -->
          
          <elementSpec ident="respStmt" mode="change">
            <desc>The element is used to describe the people's responsability for the data. It allows children elements resp and persName.</desc>
            <content>
              <sequence>
                <elementRef key="resp" minOccurs="1" maxOccurs="unbounded"/>
                <elementRef key="persName" minOccurs="1" maxOccurs="unbounded"/>
              </sequence>
            </content>
            <remarks>
              <p>This element will store Heurist metadata once extracted.</p>
            </remarks>
          </elementSpec>
          
          <!-- sourceDesc -->
          
          <elementSpec ident="sourceDesc" mode="change">
            <content>
              <elementRef key="listWit" minOccurs="0" maxOccurs="1"/>
            </content>
          </elementSpec>
          
          <!-- listWit -->
          
          <elementSpec ident="listWit" mode="change">
            <desc>Describes the list of witnesses of a text.</desc>
            <content>
              <elementRef key="witness" minOccurs="0" maxOccurs="unbounded"/>
            </content>
          </elementSpec>
          
          <!-- witness -->
          
          <elementSpec ident="witness" mode="change">
            <desc>Witness describes the witness related to the text.</desc>
            <content>
              <textNode/>
            </content>
            <attList>
              <attDef ident="xml:id" mode="change" usage="rec">
                 <datatype>
                    <dataRef name="ID"/>
                  </datatype>
              </attDef>
            </attList>
            <remarks>
              <p>The witness element can be used to link the text to its witnesses. The @xml:id is required in order
              to input the witness's id. In the data release, the link between a text and its witnesses is modelised by 
              a coupling text_H-ID/witness_H-ID. The number of time a text_H-ID is cited within a pair is the number of
              witnesses a text has.</p>
            </remarks>
          </elementSpec>
          
          <!-- encodingDesc -->
          
          <elementSpec ident="encodingDesc" mode="change">
            <content>
              <sequence>
               <elementRef key="classDecl" minOccurs="1" maxOccurs="unbounded"/>
               <elementRef key="metDecl" minOccurs="0" maxOccurs="unbounded"/>
              </sequence>
            </content>
            <remarks>
              <p>The metDecl element is of no use for this phase of the project but its future cases of use are 
              anticipated.</p>
            </remarks>
          </elementSpec>
          
          <!-- classDecl -->
          
          <elementSpec ident="classDecl" mode="change">
            <desc></desc>
            <content>
              <elementRef key="taxonomy" minOccurs="0" maxOccurs="unbounded"/>
            </content>
          </elementSpec>
          
          <!-- taxonomy -->
          
          <elementSpec ident="taxonomy" mode="change">
            <desc>The element takes a child element category, and have a required @xml:id in order to qualify its content.</desc>
            <content>
              <elementRef key="category" minOccurs="1" maxOccurs="unbounded"/>
            </content>
            <attList>
              <attDef ident="xml:id" mode="change" usage="req">
                <datatype>
                  <dataRef name="string"/>
                </datatype>
              </attDef>
            </attList>
            <remarks>
              <p>The element taxonomy is used in order to deal with a few categories that doesn't translate canonically in TEI.</p>
              <p>The @xml:id stores the name of different taxonomies : genre, litterary forme, versification, rhymes and stanza.</p>
              <p>Each of theses categories of taxonomy can be declared one by one within their own taxonomy element.</p>
            </remarks>
          </elementSpec>
          
          <!-- category -->
          
          <elementSpec ident="category" mode="change">
          <desc>Category takes child element desc and has a required @xml:id in order to qualify its content.</desc>
          <content>
            <elementRef key="desc" minOccurs="0" maxOccurs="unbounded"/>
          </content>
          <attList>
            <attDef ident="xml:id" mode="change" usage="req">
              <datatype>
                <dataRef name="string"/>
              </datatype>
            </attDef>
          </attList>
          <remarks>
            <p>The @xml:id stores the different categories of a taxonomy.</p>
            <p>For genre : arthurian-romance, arthurroman, carolingian-romance, karelepiek, chanson-de-geste, chronique,
              mise-en-prose, roman, other and unknown. They are equivalent to the DB's Genre_preferred_name.</p>
            <p>For litterary form : vers, prose, mixte, form-unknown. They are equivalent to the DB's TextTable_literary_form.</p>
            <p>For versification : alexandrine, decasyllabe, hexasyllabe, octosyllabe, iambic, petit-vers. They are equivalent
            to the DB's TextTable_verse_type.</p>
            <p>For rhyme : aliteration, full-rhyme, assonance, unknown. They are equivalent to the DB's TextTable_rhyme_type.</p>
            <p>For stanza : null, monoryhme, laisse. They are equivalent to the DB's TextTable_stanza_type.</p>
          </remarks>
          </elementSpec>

          <!-- profileDesc -->
          
          <elementSpec ident="profileDesc" mode="change">
            <desc>profileDesc is used to describe non-bibliographical aspects of the text. It takes children elements langUsage, creation, textClass, 
            textDesc and particDesc.</desc>
            <content>
             <sequence>
              <elementRef key="langUsage" minOccurs="0" maxOccurs="unbounded"/>
               <elementRef key="creation" minOccurs="0" maxOccurs="unbounded"/>
               <elementRef key="textClass" minOccurs="0" maxOccurs="unbounded"/>
               <elementRef key="textDesc" minOccurs="0" maxOccurs="unbounded"/>
               <elementRef key="particDesc" minOccurs="0" maxOccurs="unbounded"/>
              </sequence>
            </content>
            <remarks>
              <p>All those elements are set on optional mode in order to deal with the possible nulls.</p>
            </remarks>
          </elementSpec>
          
          <!-- langUsage -->
          
          <elementSpec ident="langUsage" mode="change">
            <desc>Describes in general the language used in a text. It takes language as a child, but is optional in case of nulls. </desc>
            <content>
              <elementRef key="language" minOccurs="0" maxOccurs="unbounded"/>
            </content>
          </elementSpec>
          
          <!-- language -->
          
          <elementSpec ident="language" mode="change">
            <desc>Language describes the language used in a text. It takes two optional children : lang and note. @ident is recommended in case of not null.</desc>
            <content>
             <sequence>
              <textNode/>
              <elementRef key="lang" minOccurs="0" maxOccurs="unbounded"/>
              <elementRef key="note" minOccurs="0" maxOccurs="unbounded"/>
             </sequence>
            </content>
            <attList>
            <attDef ident="ident" mode="change" usage="rec">
              <datatype>
                <dataRef name="string"/>
              </datatype>
            </attDef>
            </attList>
            <remarks>
              <p>Allow the input of DB's attribute Text_language</p>
            </remarks>
          </elementSpec>
          
          <!-- lang -->
          
          <elementSpec ident="lang" mode="change">
            <desc>Element lang stores the name of the language. It takes an @n to specify if the data is for regional language or scripta.</desc>
            <content>
              <textNode/>
            </content>
            <attList>
              <attDef ident="n" mode="change" usage="opt">
                <valList type="closed">
                  <valItem ident="regional"/>
                  <valItem ident="scripta"/>
                </valList>
              </attDef>
            </attList>
            <remarks>
              <p>Allow the input of DB's attribute TextTable_regional_writing_style (for @n=regional) and TextTable_scripta_freetext (for @n=scripta)</p>
            </remarks>
          </elementSpec>
          
          <!-- creation -->
          
          <elementSpec ident="creation" mode="change">
            <desc>Element that describes the date and place of creation of the text. MinOccurs=0 in order to deal with nulls or unknown.</desc>
            <content>
              <sequence>
                <elementRef key="date" minOccurs="0" maxOccurs="1"/>
                <elementRef key="placeName" minOccurs="0" maxOccurs="1"/>
              </sequence>
            </content>
          </elementSpec>
          
          <!-- date -->
          
          <elementSpec ident="date" mode="change">
            <desc>The element date takes a textnode and four attributes : from, to, source and cert.</desc>
            <content>
              <textNode/>
            </content>
            <attList>
              <attDef ident="from" mode="change" usage="opt">
                <desc></desc>
              </attDef>
              <attDef ident="to" mode="change" usage="opt">
                <desc></desc>
              </attDef>
              <attDef ident="source" mode="change" usage="opt">
                <desc></desc>
              </attDef>
              <attDef ident="cert" mode="change" usage="opt">
                <valList type="closed">
                  <valItem ident="low">
                    <desc>Unlikely (1%-33%)</desc>
                  </valItem>
                  <valItem ident="medium">
                    <desc>Probable (33%-66%)</desc>
                  </valItem>
                  <valItem ident="high">
                    <desc>Very likely (66%-99%)</desc>
                  </valItem>
                </valList>
              </attDef>
            </attList>
            <remarks>
              <p>The element allows to input the DB's attribute TextTable_date_of_creation in @from and @to.</p>
              <p>It also takes DB's TextTable_date_of_creation_certainty in the @cert.</p>
              <p>It also takes DB's TextTable_date_of_creation_source in the @source.</p>
              <p>It also takes DB's TextTable_date_freetext in the textnode.</p>
            </remarks>
          </elementSpec>
          
          <!-- placeName -->
          
          <elementSpec ident="placeName" mode="change">
            <desc>Element that describes the place of creation of the text. MinOccurs=0 in order to deal with nulls or unknown.</desc>
            <content>
              <textNode/>
            </content>
            <attList>
              <attDef ident="source" mode="change" usage="opt">
                 <datatype>
                   <dataRef key="teidata.pointer"/>
                 </datatype>
              </attDef>
            </attList>
            <remarks>
              <p>This element is absent from the release but exists in the Heurist modeL (Place_place_of_creation).</p>
            </remarks>
          </elementSpec>
          
          
          <!-- textClass -->
          
          <elementSpec ident="textClass" mode="change">
            <desc>Describes aspects of the nature of a text.</desc>
            <content>
              <sequence>
                <elementRef key="keywords" minOccurs="0" maxOccurs="unbounded"/>
                <elementRef key="catRef" minOccurs="0" maxOccurs="unbounded"/>
              </sequence>
            </content>
            <remarks>
              <p>textClass is used to display the data declared in taxonomy : genre, literary form, versification, rhyme, stanza.</p>
            </remarks>
          </elementSpec>
          
          <!-- keyword -->
          
          <elementSpec ident="keyword" mode="change">
            <desc></desc>
            <content>
              <elementRef key="term"/>
            </content>
          </elementSpec>
          
          <!-- term -->
          
          <elementSpec ident="term" mode="change">
            <desc></desc>
            <content>
              <textNode/>
            </content>
            <remarks>
              <p>The term element is used to input the DB's TextTable_literary_form. It can takes three values : mixed,
              prose, verse.</p>
            </remarks>
          </elementSpec>
          
          <!-- catRef -->
          
          <elementSpec ident="catRef" mode="change">
            <desc>catRef element takes two @scheme and @target both from closed valList declared in taxonomy.</desc>
            <content>
              <textNode/>
            </content>
            <attList>
              <attDef ident="scheme" mode="change" usage="opt">
                <desc>scheme refers to taxonomy xml:id element.</desc>
              </attDef>
              <attDef ident="target" mode="change" usage="opt">
                <desc>target refers to category xml:id element.</desc>
              </attDef>
            </attList>
            <remarks>
              <p>element catRef and @ allow to encode TextTable_literary_form, TextTable_verse_type, TextTable_rhyme_type, TextTable_stanza_type.</p>
            </remarks>
          </elementSpec>
          
          <!-- textDesc -->
          
          <elementSpec ident="textDesc" mode="change">
            <desc>Contains a description of a text.</desc>
            <content>
              <sequence>
                <elementRef key="channel" minOccurs="0" maxOccurs="1"/>
                <elementRef key="constitution" minOccurs="0" maxOccurs="1"/>
                <elementRef key="derivation" minOccurs="0" maxOccurs="1"/>
                <elementRef key="domain" minOccurs="0" maxOccurs="1"/>
                <elementRef key="factuality" minOccurs="0" maxOccurs="1"/>
                <elementRef key="interaction" minOccurs="0" maxOccurs="1"/>
                <elementRef key="preparedness" minOccurs="0" maxOccurs="1"/>
                <elementRef key="purpose" minOccurs="0" maxOccurs="1"/>
              </sequence>
            </content>
            <remarks>
              <p>Only the elements constitution and derivation are used but the rest is kept in order to be TEI's guidelines compliant.</p>
              <p>The constitution element stores the DB's Witness_status_witness.</p>
              <p>The derivation element stores the DB's TextTable_is_derived_from H-ID and TextTable_nature_of_derivations.</p>
            </remarks>
          </elementSpec>
          
          <!-- Derivation --> 
          
          <elementSpec ident="derivation" mode="change">
            <desc>Describes the textual derivation of a text.</desc>
            <content>
              <textNode/>
            </content>
            <attList>
              <attDef ident="corresp" mode="change" usage="opt">
                <datatype>
                  <dataRef key="teidata.pointer"/>
                </datatype>
              </attDef>
            </attList>
            <remarks>
              <p>The derivation element stores a textnode to receive TextTable_nature_of_derivations and the 
                @corresp receives TextTable_is_derived_from H-ID, and points to another text xml:id (hid_123 format).</p>
            </remarks>
          </elementSpec>
          
          <!-- particDesc -->
          
          <elementSpec ident="particDesc" mode="change">
            <desc></desc>
            <content>
              <elementRef key="listPerson"/>
            </content>
          </elementSpec>
          
          <!-- listPerson -->
          
          <elementSpec ident="listPerson" mode="change">
            <desc></desc>
            <content>
              <elementRef key="person" minOccurs="0" maxOccurs="unbounded"/>
            </content>
          </elementSpec>
          
          <!-- person -->
         
          <elementSpec ident="person" mode="change">
            <desc></desc>
            <content>
              <elementRef key="p" minOccurs="0" maxOccurs="unbounded"/>
            </content>
            <attList>
              <attDef ident="role" mode="change" usage="req">
                <desc></desc>
              </attDef>
            </attList>
            <remarks>
              <p>The @role is used to specify that this person is the author of the text. The p element stores the 
              DB's </p>
            </remarks>
          </elementSpec>
          
          
          <!-- body -->
          
          <elementSpec ident="body" mode="change">
            <desc></desc>
            <content>
              <elementRef key="graph" minOccurs="0" maxOccurs="unbounded"/>
            </content>
          </elementSpec>
        
        
          <!-- graph -->
          
        <elementSpec ident="graph" mode="change">
           <desc></desc>
          <content>
           <sequence>
            <elementRef key="label" minOccurs="1" maxOccurs="1"/>
            <elementRef key="node" minOccurs="1" maxOccurs="unbounded"/>
            <elementRef key="arc" minOccurs="0" maxOccurs="unbounded"/>
           </sequence>
          </content>
          <attList>
            <attDef ident="xml:id" mode="change" usage="req">
              <datatype>
                <dataRef name="string"/>
              </datatype>
            </attDef>
            <attDef ident="type" mode="change" usage="req">
              <datatype>
                <dataRef name="string"/>
              </datatype>
            </attDef> 
          </attList>
        </elementSpec>
        
        <!-- arc -->
          
        <elementSpec ident="arc" mode="change">
          <desc></desc>
          <content>
            <elementRef key="label" minOccurs="0" maxOccurs="unbounded"/>
          </content>
          <attList>
            <attDef ident="to" mode="change" usage="opt">
              <datatype>
               <dataRef name="string"/>
              </datatype>
            </attDef>
            <attDef ident="from" mode="change" usage="opt">
              <datatype>
                <dataRef name="string"/>
              </datatype>
            </attDef>
          </attList>
        </elementSpec>
        
        
        </schemaSpec>
      </div>
    </body>
  </text>
</TEI>
